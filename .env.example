# Copy to .env and fill in. NEVER commit .env — it is gitignored (NFR-4).
# Every override is namespaced with MF_RAG_ to avoid colliding with system env vars.

# ── STAGE 6 · LLM ────────────────────────────────────────────────────────────
# Leave blank to run in extractive mode — the demo still answers, with citations,
# using no LLM at all (architecture ADR-2, principle P8).
MF_RAG_GROQ_API_KEY=
MF_RAG_LLM_MODEL=llama-3.3-70b-versatile
MF_RAG_LLM_TEMPERATURE=0.0
MF_RAG_LLM_MAX_TOKENS=250
MF_RAG_MAX_SENTENCES=3

# ── STAGE 3 · embedding (fixed by the brief) ─────────────────────────────────
MF_RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── STAGE 5 · retrieval ──────────────────────────────────────────────────────
# top_k and min_score are PROVISIONAL. Phase 5 sets both from the chunking eval and the
# score-distribution calibration (implementation.md, Phase 5). min_score is the
# fabrication gate — chunks below it are dropped and the bot says "not in my sources".
MF_RAG_TOP_K=6
MF_RAG_MMR_K=4
MF_RAG_MMR_LAMBDA=0.7
MF_RAG_MIN_SCORE=0.25

# ── STAGE 2 · chunking ───────────────────────────────────────────────────────
# "c" = fact-grouped. Set from measurement on the real 15-page corpus, not by intuition:
# 8 of 15 pages are scheme pages whose whole body is a `## Key facts` list of ~28 labelled
# bullets (~1,100 chars, ~1.6x CHUNK_SIZE), so any fixed-width splitter cuts that list
# mid-way. Options: "a" pure recursive, "b" heading-aware, "c" fact-grouped (default).
# Phase 5's eval measures all three and can overturn this.
MF_RAG_CHUNK_STRATEGY=c
MF_RAG_CHUNK_SIZE=700
MF_RAG_CHUNK_OVERLAP=100

# ── STAGE 1 · loading ────────────────────────────────────────────────────────
MF_RAG_HTTP_TIMEOUT=30
MF_RAG_HTTP_RETRIES=3
MF_RAG_FETCH_DELAY_SECONDS=1.5
# The default UA identifies the project honestly and carries no contact address. If your
# course or org requires a contact in the UA string, set it here with a real one:
#   MF_RAG_USER_AGENT=mf-facts-rag-demo/1.0 (+class project; you@university.edu)
# MF_RAG_USER_AGENT=
